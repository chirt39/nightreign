# Create a private .env file from this template. Never commit API keys.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AI_REQUESTS_PER_MINUTE=5
AI_REQUESTS_PER_DAY=100
FRONTEND_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:5173,http://localhost:5173
# 百炼 Qwen 向量 API；若使用工作空间专属地址，请填写控制台给出的 compatible-mode/v1 地址。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSIONS=512
CHROMA_PATH=local-data/chroma
AGENT_MEMORY_DB=local-data/agent_memory.sqlite3
AGENT_MEMORY_MAX_EXCHANGES=5
AGENT_MEMORY_RETENTION_DAYS=90
# Backend-only random secret, at least 32 characters; keep blank until configured locally.
FEEDBACK_ADMIN_PASSWORD=
# Site-wide accepted feedback submissions per UTC day; default is 250.
FEEDBACK_REQUESTS_PER_DAY=250
